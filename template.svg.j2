<svg width="800" height="742" viewBox="0 0 800 742" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Drop shadow for the floating collage cards -->
    <filter id="card-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="2" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.2" />
    </filter>
    <filter id="soft-glow" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="14" />
    </filter>
    <filter id="bar-glow" x="-40%" y="-200%" width="180%" height="500%">
      <feGaussianBlur stdDeviation="2.5" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Aurora curtain filter: fractal-noise displacement + blur for wavy ribbons -->
    <filter id="aurora-warp" x="-50%" y="-40%" width="200%" height="180%">
      <feTurbulence type="fractalNoise" baseFrequency="0.006 0.022" numOctaves="3" seed="9" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="32" xChannelSelector="R" yChannelSelector="G" result="waved"/>
      <feGaussianBlur in="waved" stdDeviation="10"/>
    </filter>

    <!-- Card gradient: top-to-bottom near-black plum -> pitch black, darker than any layer of the landscape so the cards always sit in front of it. -->
    <linearGradient id="card-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%"   stop-color="#110b16" stop-opacity="0.90"/>
      <stop offset="100%" stop-color="#040205" stop-opacity="0.98"/>
    </linearGradient>
    <linearGradient id="bar-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#b98af5" />
      <stop offset="100%" stop-color="#ff9dc4" />
    </linearGradient>

    <!-- Sky gradient: deep blue overhead easing down through violet into a thin band of late sunset warmth that sits right behind the peaks. -->
    <linearGradient id="sky-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%"  stop-color="#08040d" />
      <stop offset="24%" stop-color="#1e0d2d" />
      <stop offset="34%" stop-color="#402045" />
      <stop offset="43%" stop-color="#7d5738" />
    </linearGradient>

    <!-- valley haze for each forest row: dark at the row's treeline, lifting toward mist where the next row starts. userSpaceOnUse so the ramp spans only the part of the band that stays visible. The foreground stays plum rather than black so the cards read against it. -->
    <linearGradient id="haze-1" gradientUnits="userSpaceOnUse" x1="0" y1="378" x2="0" y2="402">
      <stop offset="0" stop-color="#2a1b37" /><stop offset="1" stop-color="#3a2a4b" />
    </linearGradient>
    <linearGradient id="haze-2" gradientUnits="userSpaceOnUse" x1="0" y1="401" x2="0" y2="436">
      <stop offset="0" stop-color="#221530" /><stop offset="1" stop-color="#342443" />
    </linearGradient>
    <linearGradient id="haze-3" gradientUnits="userSpaceOnUse" x1="0" y1="434" x2="0" y2="521">
      <stop offset="0" stop-color="#1b0f27" /><stop offset="1" stop-color="#2e1e3c" />
    </linearGradient>
    <linearGradient id="haze-4" gradientUnits="userSpaceOnUse" x1="0" y1="520" x2="0" y2="742">
      <stop offset="0" stop-color="#170c21" /><stop offset="1" stop-color="#21142d" />
    </linearGradient>

    <!-- three conifer silhouettes drawn tip down: asymmetric, with branch tips that droop below the notch above them so the edge reads as needles rather than a plain triangle -->
    <path id="pine-a"
          d="M0,0 L-1.3,4.4 L-0.5,5.1 L-2.5,9.4 L-1.1,10.3 L-3.8,14.5 L-1.8,15.5
             L-5.1,19.7 L-2.5,20.8 L-6.5,25.1 L-3.1,26.2 L-7.9,31 L8.3,31
             L3.3,25.9 L6.8,24.7 L2.6,20.4 L5.4,19.2 L1.9,15.1 L4,13.9
             L1.2,9.9 L2.7,8.9 L0.6,4.8 L1.4,4.1 Z" />
    <path id="pine-b"
          d="M0,0 L-1.6,3.6 L-0.6,4.3 L-3,7.8 L-1.3,8.7 L-4.6,12.3 L-2.1,13.3
