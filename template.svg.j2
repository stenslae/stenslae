      <use href="#pine-a" transform="translate(322, 407.4) scale(3.54)" />
      </g>
    </g>
  </g>

  <!-- COLLAGE LAYOUT -->

  <!-- CARD 1: Contributions (full-width classic activity chart, top) -->
  <g id="card-contributions" transform="translate(40, 26) rotate(-0.6)">
    <!-- ART ZONE: Contributions Card Background -->
    <g id="art-card-contrib-bg"></g>

    <rect width="720" height="210" rx="18" class="card-bg" filter="url(#card-shadow)" />
    <text x="30" y="48" class="text-title">Contributions</text>
    <text x="690" y="48" class="text-title" text-anchor="end" style="font-weight: bold; font-family: system-ui;">{{ stats.total_contribs | commas }}</text>

    <!-- Classic GitHub-style calendar: weekday labels, month labels, week/day grid -->
    <g transform="translate(66, 92)">
      <!-- baseline sits ~3.5px below the row's centre so the 10px label is optically centred on it -->
      <text x="-14" y="{{ 1 * cal_pitch + cal_cell / 2 + 3.5 }}" text-anchor="end" class="text-cal-label">Mon</text>
      <text x="-14" y="{{ 3 * cal_pitch + cal_cell / 2 + 3.5 }}" text-anchor="end" class="text-cal-label">Wed</text>
      <text x="-14" y="{{ 5 * cal_pitch + cal_cell / 2 + 3.5 }}" text-anchor="end" class="text-cal-label">Fri</text>

      {% for m in month_labels %}
        <text x="{{ m.x }}" y="-8" class="text-cal-label">{{ m.label }}</text>
      {% endfor %}

      <!-- Cells are drawn fully visible and the fade-in starts at 0s, holding at 0 until each cell's stagger point. Anything that doesn't run SMIL (static previews, snapshots) still shows the finished calendar instead of an empty grid. -->
      {% for dot in calendar_dots %}
        <rect x="{{ dot.x }}" y="{{ dot.y }}" width="{{ cal_cell }}" height="{{ cal_cell }}" rx="2"
              class="cal-lvl-{{ dot.level }}">
          {% set dur = dot.delay + 0.5 %}
          <animate attributeName="opacity" values="0;0;1" keyTimes="0;{{ '%.4f' % (dot.delay / dur) }};1"
                   dur="{{ dur }}s" begin="0s" fill="freeze" />
        </rect>
      {% endfor %}
    </g>

    <!-- ART ZONE: Contributions Card Foreground -->
    <g id="art-card-contrib-fg"></g>
  </g>

  <!-- ART ZONE: MIDGROUND - open valley band between card 1 and the bottom row, where the near Teton ridgeline reads clearly. -->
  <g id="art-midground"></g>

  <!-- CARD 2: Languages (bottom left) -->
  <g id="card-languages" transform="translate(40, 372) rotate(0.4)">
    <!-- ART ZONE: Languages Card Background -->
    <g id="art-card-lang-bg"></g>

    <rect width="460" height="300" rx="18" class="card-bg" filter="url(#card-shadow)" />
    <text x="30" y="48" class="text-title">Languages</text>

    <g transform="translate(30, 88)">
      {% for lang in stats.langs %}
        <g transform="translate(0, {{ loop.index0 * 30 }})">
          <text x="0" y="0" class="text-lang-name">{{ lang.name }}</text>
          <text x="400" y="0" class="text-lang-pct" text-anchor="end">{{ lang.size_label }}</text>
          <!-- True bar chart: length is size relative to the largest language shown, not a percentage of a whole. Gradient fill + soft glow, animated width. -->
          <rect x="0" y="8" width="400" height="4" rx="2" fill="#30203e" opacity="0.5" />
          <!-- Drawn at full length, same static-fallback pattern as the calendar cells: the grow animation holds at 0 until this row's stagger point. -->
          {% set bar_w = '%.1f' % ((lang.bar_pct / 100.0) * 400) %}
          {% set delay = loop.index0 * 0.15 %}
          <rect x="0" y="8" width="{{ bar_w }}" height="4" rx="2" fill="url(#bar-grad)" filter="url(#bar-glow)" opacity="0.9">
            <animate attributeName="width" values="0;0;{{ bar_w }}" keyTimes="0;{{ '%.4f' % (delay / (delay + 1.2)) }};1"
                     dur="{{ delay + 1.2 }}s" begin="0s" fill="freeze"
                     calcMode="spline" keySplines="0 0 1 1;0.25 0.1 0.25 1" />
          </rect>
        </g>
      {% endfor %}
    </g>

    <!-- ART ZONE: Languages Card Foreground -->
    <g id="art-card-lang-fg"></g>
  </g>

  <!-- CARD 3: Merged open-source PRs + streaks (bottom right, top half) -->
  <g id="card-stats" transform="translate(540, 372) rotate(-1.4)">
    <!-- ART ZONE: Stats Card Background -->
    <g id="art-card-stats-bg"></g>

    <rect width="220" height="158" rx="18" class="card-bg" filter="url(#card-shadow)" />

    <g transform="translate(24, 68)">
      <text x="0" y="0" class="text-data-bold">{{ stats.oss_prs | commas }}</text>
      <text x="0" y="24" class="text-data-label">Merged OSS PRs</text>
      <text x="0" y="43" class="text-lang-pct" style="font-style: italic;">{{ stats.current_streak | commas }}-day streak</text>
      <text x="0" y="61" class="text-lang-pct" style="font-style: italic;">Longest: {{ stats.longest_streak | commas }} days</text>
    </g>

    <!-- ART ZONE: Stats Card Foreground -->
    <g id="art-card-stats-fg"></g>
  </g>

  <!-- CARD 4: Website Link (bottom right, bottom half) -->
  <g id="card-link" transform="translate(540, 550) rotate(1.6)">
    <!-- ART ZONE: Link Card Background -->
    <g id="art-card-link-bg"></g>

    <rect width="220" height="136" rx="18" class="card-bg" filter="url(#card-shadow)" />

    <a href="https://emma-stensland.com" target="_blank" rel="noopener noreferrer">
      <text x="110" y="44" text-anchor="middle" class="text-link">emma-stensland.com</text>
      <line x1="25" y1="53" x2="195" y2="53" stroke="#ff5c93" stroke-width="1.5" />
    </a>

    <!-- Small best-effort widgets sourced from the site itself at generation time - see get_site_widgets() in update_svg.py. Any subset can be missing (site hiccup) and this just renders fewer lines, never a broken one. -->
    <g transform="translate(25, 70)" text-anchor="start">
      {% if site.guestbook_count is not none %}
        <text x="0" y="0" class="text-tiny">• {{ site.guestbook_count | commas }} guestbook signs</text>
      {% endif %}
      {% if site.bot_count is not none %}
        <text x="0" y="16" class="text-tiny">• {{ site.bot_count | commas }} bots caught</text>
      {% endif %}
      {% if site.poison_size %}
        <text x="0" y="32" class="text-tiny">• {{ site.poison_size }} fed to bots</text>
      {% endif %}
    </g>

    <!-- ART ZONE: Link Card Foreground -->
    <g id="art-card-link-fg"></g>
  </g>

  <!-- ART ZONE: FOREGROUND -->
  <g id="art-foreground"></g>

</svg>
