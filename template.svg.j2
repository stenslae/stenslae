  </defs>

  <style>
    /* One dusk palette throughout: indigo structure, amber warm accent, rose and violet cool accents */
    .bg { fill: url(#sky-grad); }

    /* hairline rim so the cards separate from the darkest foreground */
    .card-bg { fill: url(#card-grad); stroke: #ffb2d2; stroke-opacity: 0.1; stroke-width: 1; }

    .text-title { font-family: 'Georgia', serif; font-size: 20px; fill: #ffb2d2; font-style: italic; letter-spacing: 0.5px; }

    /* Sans-serif for clean data readability */
    .text-data-bold { font-family: system-ui, -apple-system, sans-serif; font-size: 44px; font-weight: 800; fill: #ff5c93; letter-spacing: -1px; }
    .text-data-label { font-family: system-ui, -apple-system, sans-serif; font-size: 13px; font-weight: 500; fill: #e8b07f; text-transform: uppercase; letter-spacing: 1px; }

    .text-lang-name { font-family: system-ui, -apple-system, sans-serif; font-size: 14px; font-weight: 600; fill: #ff9dc4; }
    .text-lang-pct { font-family: system-ui, -apple-system, sans-serif; font-size: 12px; font-weight: 400; fill: #ffd0de; }

    .text-cal-label { font-family: system-ui, -apple-system, sans-serif; font-size: 10px; font-weight: 500; fill: #a685ad; }

    .text-link { font-family: system-ui, -apple-system, sans-serif; font-size: 16px; font-weight: 700; fill: #ff5c93; }

    .text-tiny { font-family: system-ui, -apple-system, sans-serif; font-size: 9.5px; font-weight: 500; fill: #ffd0de; }

    /* Contribution calendar cells: every level is rose, and busier days get both brighter and more vivid (OKLCH L .40 -> .75, C .075 -> .21 at the sRGB edge), so quiet days recede as dusky rose instead of grey and no busier level is dimmer than a quieter one. */
    .cal-lvl-0 { fill: #2c2233; }
    .cal-lvl-1 { fill: #67354a; }
    .cal-lvl-2 { fill: #a34770; }
    .cal-lvl-3 { fill: #df4e92; }
    .cal-lvl-4 { fill: #ff69b5; }

    /* Subtle dusk-sky motion: twinkling stars, drifting aurora. Each star carries its own duration and phase inline (see generate_stars), so the sky never pulses in unison. */
    @keyframes twinkle { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
    @keyframes drift { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(10px); } }
    .star { fill: #ffd0de; }
    .twinkle { animation: twinkle 4s ease-in-out infinite; }
    .aurora-drift { animation: drift 14s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    @media (prefers-reduced-motion: reduce) {
      .twinkle, .aurora-drift { animation: none; }
    }
  </style>

  <!-- ART ZONE: BACKGROUND -->
  <g id="art-background">
    <rect width="800" height="742" class="bg" />

    <!-- AURORA: tall vertical ribbons of colored light, displaced by fractal noise for the wavy curtain effect. -->
    <g style="opacity: 0.7">
      <!-- primary violet curtain, left of center -->
      <rect x="50"  y="-90" width="220" height="310" rx="90"
            fill="#b98af5" opacity="0.11" filter="url(#aurora-warp)"
            class="aurora-drift" />
      <!-- secondary amber layer, slightly offset for layered glow -->
      <rect x="170" y="-60" width="150" height="260" rx="70"
            fill="#e0a878" opacity="0.09" filter="url(#aurora-warp)"
            class="aurora-drift" style="animation-delay: -3s;" />
      <!-- pink/magenta curtain, right of center -->
      <rect x="430" y="-80" width="200" height="290" rx="80"
            fill="#ff9dc4" opacity="0.09" filter="url(#aurora-warp)"
            class="aurora-drift" style="animation-delay: -7s;" />
      <!-- violet accent, far right -->
      <rect x="590" y="-50" width="170" height="240" rx="65"
            fill="#b98af5" opacity="0.08" filter="url(#aurora-warp)"
            class="aurora-drift" style="animation-delay: -11s;" />
    </g>

    <!-- MILKY WAY + STARS: a soft diagonal glow band (the Milky Way core) plus a scattered star field that thins out toward the horizon glow. -->
    <g>
      <!-- Milky Way soft glow: blurred diagonal band crossing the sky -->
      <ellipse cx="310" cy="190" rx="450" ry="60"
               fill="#ffd0de" opacity="0.045" filter="url(#soft-glow)"
               transform="rotate(-22, 310, 190)" />
      <!-- star field: generated by generate_stars() in update_svg.py, each with its own twinkle period and phase -->
      {% for star in stars %}
      <circle class="star{% if star.dur %} twinkle{% endif %}" cx="{{ star.x }}" cy="{{ star.y }}" r="{{ star.r }}" fill-opacity="{{ star.opacity }}"{% if star.dur %} style="animation-duration: {{ star.dur }}s; animation-delay: {{ star.delay }}s;"{% endif %}/>
      {% endfor %}
    </g>


