             L0.9,11.8 L2.1,10.9 L0.5,5.7 L1.1,4.9 Z" />

    <!-- distant versions of the same three conifers, same heights so they drop into the same positions: fewer tiers with deeper notches, so the needled edge still reads at a few pixels tall instead of collapsing to a plain triangle -->
    <path id="pine-far-a"
          d="M0,0 L-3.2,7.5 L-1.3,7 L-4.8,15 L-2,14.2 L-6.4,22.6 L-2.6,21.8 L-8,31
